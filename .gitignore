# Dependencies
node_modules/

# Build output
dist/
release/
out/
# build/ 是 electron-builder 的资源目录（图标），只忽略其中的产物，保留图标资产
build/*
!build/icon.svg
!build/icon.png
!build/icon-mac.png
!build/icons/

